{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oujinhaoai/lantai/raw/main/schemas/tasks/v1/defs.schema.json",
  "title": "lantai.tasks-defs/v1",
  "description": "任务与业务流程的值类型；AgentStepRun 不属于业务 StepRun。",
  "$defs": {
    "task_state": {
      "type": "string",
      "enum": [
        "waiting",
        "todo",
        "claimed",
        "reconciling",
        "blocked",
        "submitted",
        "done",
        "rework",
        "cancelled"
      ]
    },
    "seat_state": {
      "type": "string",
      "enum": [
        "open",
        "claimed",
        "reconciling",
        "submitted",
        "done",
        "cancelled"
      ]
    },
    "attempt_state": {
      "type": "string",
      "enum": [
        "active",
        "reconciling",
        "submitted",
        "released",
        "cancelled",
        "expired"
      ]
    },
    "flow_state": {
      "type": "string",
      "enum": [
        "running",
        "waiting",
        "paused",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "step_state": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "running",
        "waiting",
        "blocked",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "input_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refs",
        "digest"
      ],
      "properties": {
        "refs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/permanent_ref"
          },
          "uniqueItems": true
        },
        "digest": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/digest"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termination_confirmed",
        "unresolved_effects",
        "evidence_refs"
      ],
      "properties": {
        "termination_confirmed": {
          "type": "boolean"
        },
        "unresolved_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
          },
          "uniqueItems": true
        }
      }
    },
    "definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "definition_digest"
      ],
      "properties": {
        "ref": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/permanent_ref"
        },
        "definition_digest": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/digest"
        }
      }
    },
    "output_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "asset_type",
        "candidate_count"
      ],
      "properties": {
        "slug": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/normalized_slug"
        },
        "asset_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    }
  }
}
