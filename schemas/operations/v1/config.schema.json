{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oujinhaoai/lantai/raw/main/schemas/operations/v1/config.schema.json",
  "title": "InstanceConfig",
  "description": "数据根目录下可选的 config.yaml。只放服务配置，不放密钥或凭据；缺省时全部取默认值。未知字段一律拒绝，避免拼错的配置被静默忽略。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract"
  ],
  "properties": {
    "contract": {
      "const": "lantai.config/v1"
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "初始化时写入实例标记的名称；已初始化实例以标记为准。",
          "$ref": "instance.schema.json#/$defs/instance_name"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "description": "主密钥等密钥材料的目录；相对路径以数据根目录为基准，默认 secrets。生产环境宜放在单独受控并单独备份的位置。",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_free_bytes": {
          "description": "数据根所在文件系统的最低可用空间；低于它时实例不开放写入。默认 1 GiB。",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allow_fuse": {
          "description": "数据根或库目录在 FUSE 文件系统上时，默认拒绝初始化与启动。只有在该位置不同时段多次通过 SQLite 并发实测、并接受库可能被间歇性写坏的风险时才设为 true；实测通过不能证明 FUSE 位置安全，见部署文档的数据位置。默认 false。",
          "type": "boolean"
        },
        "max_file_bytes": {
          "description": "上传会话中单个文件的最大字节数，超限返回 QUOTA_EXCEEDED（file_too_large）。默认 1 TiB。与 max_upload_bytes 同时设置时不能大于它。",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_upload_bytes": {
          "description": "单个上传会话申报的总字节数上限，超限返回 QUOTA_EXCEEDED（upload_too_large）。默认 4 TiB。",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_upload_files": {
          "description": "单个上传会话（即一个版本清单）的文件数上限，超限返回 QUOTA_EXCEEDED（too_many_files）。默认 100000。创建会话的请求是 JSON，文件很多时还需相应调高 http.max_json_bytes。",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "upload_idle_expiry_seconds": {
          "description": "上传会话无活动后的到期秒数，每次活动按此值续期，且不超过绝对到期。默认 86400（24 小时）。与 upload_absolute_expiry_seconds 同时设置时不能大于它。",
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        },
        "upload_absolute_expiry_seconds": {
          "description": "上传会话自创建起的绝对到期秒数，创建时写定，修改只影响之后创建的会话。默认 604800（7 天）。",
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        }
      }
    },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "description": "核心内部 JSON API 监听；默认 127.0.0.1:8080。"
        },
        "transfer": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "description": "核心内部文件传输监听；默认 127.0.0.1:8081。"
        },
        "operations": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "description": "仅允许数字形式的 loopback 地址；默认 127.0.0.1:9090，不经网关。"
        },
        "merged": {
          "type": "boolean",
          "description": "开发模式将 API 与传输合用 API 监听；默认 false。"
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_origins": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "max_json_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864,
          "description": "仅限制 JSON 请求；默认 8 MiB，不用于流式文件传输。"
        },
        "api_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "API 请求处理超时；默认 30 秒。"
        }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interactive_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "batch_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "batch_per_principal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "batch_bytes_per_second": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "batch_bytes_per_second_while_interactive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "description": "T08 到期清除、提醒与 GC 调度。默认关闭；开启是明确的部署决定，业务是否允许清除仍由台账规则与项目策略 trash.auto_purge 裁决。",
      "properties": {
        "scheduler": {
          "type": "boolean",
          "description": "是否在 serve 中周期运行调度；默认 false。"
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400,
          "description": "两次调度之间的秒数；默认 300。"
        },
        "batch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "每次调度每类最多处理的条目；默认 100。"
        }
      }
    }
  }
}
