{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/execution-capabilities.schema.json",
  "title": "lantai.execution-capabilities/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "protocol_versions",
    "adapter_kind",
    "backend_version",
    "supports_idempotent_start",
    "supports_lookup_by_key",
    "resume_classes",
    "cancel_mode",
    "artifact_mode",
    "capabilities",
    "budget_meters",
    "checkpoint_format_versions"
  ],
  "properties": {
    "contract": {
      "const": "lantai.execution-capabilities/v1"
    },
    "protocol_versions": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "const": "lantai.agent-execution/v1"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "adapter_kind": {
      "type": "string",
      "enum": [
        "manual_cli",
        "managed_runner"
      ]
    },
    "backend_version": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/extension_version"
    },
    "supports_idempotent_start": {
      "const": true
    },
    "supports_lookup_by_key": {
      "const": true
    },
    "resume_classes": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/execution.schema.json#/$defs/resume_class"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "cancel_mode": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/execution.schema.json#/$defs/cancel_mode"
    },
    "artifact_mode": {
      "type": "string",
      "enum": [
        "lantai_refs",
        "candidate_manifest"
      ]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "uniqueItems": true
    },
    "budget_meters": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "wall_time",
          "model_calls",
          "tool_calls",
          "tokens",
          "artifact_bytes",
          "cost"
        ]
      },
      "uniqueItems": true
    },
    "checkpoint_format_versions": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter_kind": {
            "enum": [
              "manual_cli"
            ]
          }
        },
        "required": [
          "adapter_kind"
        ]
      },
      "then": {
        "properties": {
          "cancel_mode": {
            "const": "revoke_only"
          },
          "budget_meters": {
            "not": {
              "contains": {
                "enum": [
                  "tokens",
                  "cost"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resume_classes": {
            "contains": {
              "const": "backend_checkpoint"
            }
          }
        },
        "required": [
          "resume_classes"
        ]
      },
      "then": {
        "properties": {
          "checkpoint_format_versions": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
