{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/artifact-candidate.schema.json",
  "title": "lantai.artifact-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "task_run_id",
    "attempt_id",
    "manifest_digest",
    "files",
    "purpose",
    "provenance_refs",
    "license_evidence_refs",
    "validation_state"
  ],
  "properties": {
    "contract": {
      "const": "lantai.artifact-candidate/v1"
    },
    "id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "task_run_id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "attempt_id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "manifest_digest": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/digest"
    },
    "files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/defs.schema.json#/$defs/artifact_file"
      },
      "minItems": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "provenance_refs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
      },
      "uniqueItems": true
    },
    "license_evidence_refs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
      },
      "uniqueItems": true
    },
    "validation_state": {
      "type": "string",
      "enum": [
        "pending",
        "valid",
        "invalid"
      ]
    },
    "producer": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/producer_ref"
    }
  }
}
