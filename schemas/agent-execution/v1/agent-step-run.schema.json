{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/agent-step-run.schema.json",
  "title": "lantai.agent-step-run/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "task_run_id",
    "attempt_id",
    "revision",
    "plan_revision",
    "kind",
    "state",
    "input_refs",
    "tool_operation_ids",
    "output_refs"
  ],
  "properties": {
    "contract": {
      "const": "lantai.agent-step-run/v1"
    },
    "id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "task_run_id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "attempt_id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "revision": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/revision"
    },
    "plan_revision": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/revision"
    },
    "parent_id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "plan",
        "tool",
        "delegate",
        "validate",
        "deliver"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled",
        "needs_reconciliation"
      ]
    },
    "input_refs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/permanent_ref"
      },
      "uniqueItems": true
    },
    "tool_operation_ids": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
      },
      "uniqueItems": true
    },
    "output_refs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/permanent_ref"
      },
      "uniqueItems": true
    }
  }
}
