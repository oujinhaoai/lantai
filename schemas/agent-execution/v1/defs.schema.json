{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/defs.schema.json",
  "title": "lantai.agent-execution-defs/v1",
  "description": "Agent 执行值类型；job_fence 的所有者为 jobs，不能作为 task_fence。",
  "$defs": {
    "package_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension_id",
        "extension_version",
        "package_digest",
        "target",
        "entry",
        "entry_digest"
      ],
      "properties": {
        "extension_id": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/extension_id"
        },
        "extension_version": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/extension_version"
        },
        "package_digest": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/digest"
        },
        "target": {
          "type": "string",
          "enum": [
            "server",
            "node"
          ]
        },
        "entry": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/relative_path"
        },
        "entry_digest": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/digest"
        }
      }
    },
    "budget_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms",
        "model_calls",
        "tool_calls",
        "subagent_depth",
        "subagent_count",
        "concurrency",
        "artifact_bytes"
      ],
      "properties": {
        "wall_time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "subagent_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "subagent_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "budget_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms",
        "model_calls",
        "tool_calls",
        "artifact_bytes"
      ],
      "properties": {
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "revision",
        "profile_digest"
      ],
      "properties": {
        "profile_id": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
        },
        "revision": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/revision"
        },
        "profile_digest": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/digest"
        }
      }
    },
    "artifact_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/sha256_hex"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "job_fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "job_attempt_id",
        "lease_fence",
        "recovery_epoch"
      ],
      "properties": {
        "job_id": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
        },
        "job_attempt_id": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
        },
        "lease_fence": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/epoch"
        },
        "recovery_epoch": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/epoch"
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "action",
        "execution_id"
      ],
      "properties": {
        "protocol": {
          "const": "lantai.agent-execution/v1"
        },
        "action": {
          "type": "string",
          "enum": [
            "status",
            "result"
          ]
        },
        "execution_id": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
        }
      }
    }
  }
}
