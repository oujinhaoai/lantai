{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/job-attempt.schema.json",
  "title": "lantai.job-attempt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "job_id",
    "operation_id",
    "revision",
    "protocol",
    "job_fence",
    "input_snapshot",
    "state",
    "termination"
  ],
  "properties": {
    "contract": {
      "const": "lantai.job-attempt/v1"
    },
    "id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "job_id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "operation_id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "revision": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/revision"
    },
    "protocol": {
      "enum": [
        "lantai.processor/v1",
        "lantai.local-assistant/v1"
      ]
    },
    "job_fence": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/defs.schema.json#/$defs/job_fence"
    },
    "activation_snapshot": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/activation-snapshot.schema.json"
    },
    "input_snapshot": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/tasks/v1/defs.schema.json#/$defs/input_snapshot"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "cancelling",
        "needs_reconciliation",
        "completed"
      ]
    },
    "termination": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/execution.schema.json#/$defs/termination"
    },
    "outcome": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/execution.schema.json#/$defs/invocation_outcome"
    },
    "verdict": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/execution.schema.json#/$defs/check_verdict"
    },
    "result_digest": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/digest"
    },
    "local_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "workspace_alias",
        "workspace_binding",
        "job_digest",
        "approval_digest"
      ],
      "properties": {
        "device_id": {
          "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
        },
        "workspace_alias": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "workspace_binding": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "job_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approval_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "completed"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "outcome",
          "verdict"
        ],
        "properties": {
          "termination": {
            "properties": {
              "termination_confirmed": {
                "const": true
              },
              "unresolved_effects": {
                "const": 0
              }
            }
          },
          "outcome": {
            "not": {
              "const": "unresolved"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "completed"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "result_digest"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "not_dispatched",
              "cancelled",
              "runtime_fault",
              "unresolved"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "unknown"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "completed",
              "not_dispatched",
              "cancelled",
              "runtime_fault"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "unresolved"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "needs_reconciliation"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "outcome"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "protocol": {
            "const": "lantai.local-assistant/v1"
          }
        }
      },
      "then": {
        "required": [
          "local_execution"
        ],
        "not": {
          "required": [
            "activation_snapshot"
          ]
        }
      },
      "else": {
        "required": [
          "activation_snapshot"
        ],
        "not": {
          "required": [
            "local_execution"
          ]
        }
      }
    }
  ]
}
