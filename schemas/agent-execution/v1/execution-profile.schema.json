{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/execution-profile.schema.json",
  "title": "lantai.execution-profile/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "revision",
    "adapter_kind",
    "adapter_version",
    "activation_snapshot",
    "playbook_refs",
    "skill_digests",
    "required_capabilities",
    "allowed_tools",
    "network_policy",
    "network_allowlist",
    "budget_limits",
    "result_schema"
  ],
  "properties": {
    "contract": {
      "const": "lantai.execution-profile/v1"
    },
    "id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "revision": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/revision"
    },
    "adapter_kind": {
      "type": "string",
      "enum": [
        "manual_cli",
        "managed_runner"
      ]
    },
    "adapter_version": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/extension_version"
    },
    "activation_snapshot": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/activation-snapshot.schema.json"
    },
    "playbook_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/permanent_ref"
      },
      "uniqueItems": true
    },
    "skill_digests": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/digest"
      },
      "uniqueItems": true
    },
    "required_capabilities": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "uniqueItems": true
    },
    "allowed_tools": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/command_type"
      },
      "uniqueItems": true
    },
    "network_policy": {
      "type": "string",
      "enum": [
        "none",
        "allowlist"
      ]
    },
    "network_allowlist": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253
      },
      "uniqueItems": true
    },
    "budget_limits": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/defs.schema.json#/$defs/budget_limits"
    },
    "result_schema": {
      "const": "lantai.agent-result/v1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "network_policy": {
            "enum": [
              "none"
            ]
          }
        },
        "required": [
          "network_policy"
        ]
      },
      "then": {
        "properties": {
          "network_allowlist": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
