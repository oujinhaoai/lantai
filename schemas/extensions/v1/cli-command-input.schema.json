{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oujinhaoai/lantai/raw/main/schemas/extensions/v1/cli-command-input.schema.json",
  "title": "lantai.cli-command-input/v1",
  "description": "lantai ext run 写给本机一次性命令的 job.json。输入为用户显式选择文件的只读副本；不含兰台凭据、HumanGrant 或 shell 命令串。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "operation_id",
    "command",
    "args",
    "inputs",
    "deadline",
    "producer"
  ],
  "properties": {
    "contract": {
      "const": "lantai.cli-command-input/v1"
    },
    "operation_id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "command": {
      "description": "已启用的 cli.command 贡献 ID。",
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "args": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^/\\\\]+$"
          },
          "sha256": {
            "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/sha256_hex"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "deadline": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/timestamp"
    },
    "producer": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/producer_ref"
    },
    "config": {
      "type": "object"
    }
  }
}
