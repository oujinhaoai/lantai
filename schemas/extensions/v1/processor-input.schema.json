{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oujinhaoai/lantai/raw/main/schemas/extensions/v1/processor-input.schema.json",
  "title": "lantai.processor-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "operation_id",
    "job_fence",
    "input_refs",
    "input_digest",
    "deadline"
  ],
  "properties": {
    "contract": {
      "const": "lantai.processor-input/v1"
    },
    "operation_id": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/ulid"
    },
    "job_fence": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/defs.schema.json#/$defs/job_fence"
    },
    "input_refs": {
      "type": "array",
      "maxItems": 1000,
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/permanent_ref"
      }
    },
    "input_digest": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/digest"
    },
    "deadline": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/timestamp"
    },
    "activation_snapshot": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/agent-execution/v1/activation-snapshot.schema.json"
    },
    "producer": {
      "$ref": "https://github.com/oujinhaoai/lantai/raw/main/schemas/common/v1/defs.schema.json#/$defs/producer_ref"
    },
    "config": {
      "description": "冻结的有效配置（按包 config_schema 校验）；内置检查器与合成探测不携带。",
      "type": "object"
    },
    "mode": {
      "description": "probe 为获授权、无业务输入与副作用的合成探测；缺省为正常调用。",
      "type": "string",
      "enum": [
        "invoke",
        "probe"
      ]
    }
  }
}
